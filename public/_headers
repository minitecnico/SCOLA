# O service worker e o manifesto nunca ficam em cache: a versão nova chega na hora.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# Arquivos com hash no nome podem ficar em cache "para sempre".
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Segurança do app: nada de embutir o SCOLA em outro site, nada de adivinhar tipo de arquivo,
# só HTTPS, câmera só para o próprio app (leitor de provas) e política de conteúdo restritiva.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' wss: https://brasilapi.com.br; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
